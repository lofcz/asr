[Unit]
Description=Durable ASR audio download queue
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python /home/lofcz/.local/lib/asr-downloader/audio_worker.py --config /home/lofcz/.local/state/asr-downloader/config.json run
WorkingDirectory=/home/lofcz/.local/lib/asr-downloader
Restart=always
RestartSec=15
WatchdogSec=120
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=control-group
UMask=0027
Nice=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
