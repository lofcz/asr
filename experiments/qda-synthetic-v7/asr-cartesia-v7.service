[Unit]
Description=Durable 60h Czech Slovak Cartesia dataset preparation
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/run/media/lofcz/ssd_external/GitHub/asr
ExecStart=/usr/bin/python -u /run/media/lofcz/ssd_external/GitHub/asr/experiments/qda-synthetic-v7/pipeline.py --workers 12 --tts-workers 15
Environment=PATH=/home/lofcz/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=120
TimeoutStopSec=700
KillMode=mixed

[Install]
WantedBy=default.target
