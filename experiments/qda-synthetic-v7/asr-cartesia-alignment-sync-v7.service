[Unit]
Description=Copy completed Cartesia recordings with native word timestamps
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/run/media/lofcz/ssd_external/GitHub/asr
ExecStart=/usr/bin/python -u /run/media/lofcz/ssd_external/GitHub/asr/experiments/qda-synthetic-v7/sync_alignment.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
