[Unit]
Description=Export Cartesia audio and known-speaker native timestamps for VibeVoice

[Service]
WorkingDirectory=/run/media/lofcz/ssd_external/GitHub/asr
ExecStart=/usr/bin/python -u /run/media/lofcz/ssd_external/GitHub/asr/experiments/qda-synthetic-v7/export_training.py
